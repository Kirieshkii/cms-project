# .env.test — ЗАХАРДКОДЕНО ДЛЯ ТЕСТОВ (git)
PG_TEST_HOST=127.0.0.1
PG_TEST_PORT=5432
PG_TEST_USER=testuser
PG_TEST_PASSWORD=testpass
PG_TEST_DB=testdb
PG_TEST_SSLMODE=disable

# DSN для golang-migrate (используем postgres://user:pass@host:port/db?sslmode=disable)
PG_TEST_DSN=postgres://testuser:testpass@127.0.0.1:5432/testdb?sslmode=disable
